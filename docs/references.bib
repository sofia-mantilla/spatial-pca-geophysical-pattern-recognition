	number = {5},
	urldate = {2024-02-19},
	journal = {Greenhouse Gases: Science and Technology},
	author = {Zheng, Liange and Nico, Peter and Spycher, Nicolas and Domen, Jeremy and Credoz, Anthony},
	month = oct,
	year = {2021},
	pages = {1134--1166},
	file = {Full Text:/Users/sofiamantillasalas/Zotero/storage/L9Y6EYMP/Zheng et al. - 2021 - Potential impacts of CO 2 leakage on gr.pdf:application/pdf},
