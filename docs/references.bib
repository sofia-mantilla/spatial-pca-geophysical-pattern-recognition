@article{wang_unraveling_2023-1,
	title = {Unraveling the uncertainty of geological interfaces through data-knowledge-driven trend surface analysis},
	volume = {178},
	issn = {0098-3004},
	url = {https://www.sciencedirect.com/science/article/pii/S0098300423001231},
	doi = {10.1016/j.cageo.2023.105419},
	abstract = {Modeling complex geological interfaces is a common task in geosciences. Many data sources are available for geological interface modeling, including borehole data and geophysical surveys. Geological knowledge, such as the delineation from geologists, is difficult to quantify but likely adds value to geological interface modeling. To integrate all information, we present a data-knowledge-driven trend surface analysis method to construct stochastic geological interfaces. We design a Metropolis–Hastings sampling framework to sample stochastic trend interfaces and quantify the uncertainty of geological interfaces given all information sources. This method is suitable for both explicit and implicit representations of geological interfaces. We demonstrate our method in three different test cases: modeling stochastic interfaces of Greenland subglacial topography, magmatic intrusion, and buried river valleys in Australia.},
	urldate = {2025-10-02},
	journal = {Computers \& Geosciences},
	author = {Wang, Lijing and Peeters, Luk and MacKie, Emma J. and Yin, Zhen and Caers, Jef},
	month = sep,
	year = {2023},
	keywords = {Geological knowledge, Implicit modeling, Level sets, Metropolis–Hastings sampling, Trend surface analysis},
	pages = {105419},
	file = {ScienceDirect Snapshot:/Users/sofiamantillasalas/Zotero/storage/H8FQEUCS/S0098300423001231.html:text/html},
}

