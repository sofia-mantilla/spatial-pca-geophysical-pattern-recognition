@article{brummer_historical_1987,
	title = {A historical perspective of exploration geochemistry in {Canada} — {The} first 30 years},
	volume = {28},
	issn = {0375-6742},
	url = {https://www.sciencedirect.com/science/article/pii/0375674287900380},
	doi = {10.1016/0375-6742(87)90038-0},
	abstract = {The history of geochemical exploration in Canada during the period from its initiation in 1938 by Dr. Hans Lundberg to 1968 is outlined. During this 30-year period, methods based on rock, soil, drainage sediment, and vegetation analyses in terranes as varied as those in the Appalachian Orogen, the Canadian Shield and Cordilleran Orogen have been applied with considerable success. Geochemical methods have led directly to or assisted in the discovery of some 18 significant metal deposits of a varied nature in Canada during this period and since then of another 23 deposits. The discoveries include: porphyry copper and molybdenum deposits, lead-zinc-silver deposits, zinc deposits, a rare earth deposit, uranium deposits and precious metal deposits.},
	number = {1},
	urldate = {2025-10-08},
