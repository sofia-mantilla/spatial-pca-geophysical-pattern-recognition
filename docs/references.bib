	file = {arXiv Fulltext PDF:/Users/sofiamantillasalas/Zotero/storage/2395QYIE/Ronneberger et al. - 2015 - U-Net Convolutional Networks for Biomedical Image.pdf:application/pdf;arXiv.org Snapshot:/Users/sofiamantillasalas/Zotero/storage/PS9DJPQR/1505.html:text/html},
}

