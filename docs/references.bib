	month = feb,
	year = {2022},
	pages = {e2021JB023157},
	file = {Full Text:/Users/sofiamantillasalas/Zotero/storage/NMXGQXNL/Pepin et al. - 2022 - Shallow Aseismic Slip in the Delaware Basin Determ.pdf:application/pdf},
